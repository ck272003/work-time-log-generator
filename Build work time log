#!/usr/bin/env python3
"""
Work Time Log Generator
=======================
Builds a ready-to-use Excel workbook for tracking daily work:

  * Time Log  - one row per task, auto-calculated Log ID, Day, Week, Month and
                Hours (handles shifts that cross midnight), dropdowns,
                date/time validation, colour-coded status, yellow highlight for
                rows with missing start/end times.
  * Summary   - live tables: hours & entries by category, status, month, week.
  * Lists     - editable dropdown values.
  * How to Use - short instructions and colour legend.

Everything in the workbook is a real Excel formula, so it keeps recalculating
after you edit it. The data below is FICTIONAL sample data.

Usage:
    python build_work_time_log.py                       # sample data included
    python build_work_time_log.py --no-sample           # empty log
    python build_work_time_log.py --owner "Jane Doe" --org "Acme Corp" -o log.xlsx
"""
import argparse
